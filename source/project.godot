[input_devices]

; v7b.1: menus need taps as clicks on phones (emulated mouse); mouse look ignores
; emulated events and TouchControls swallows the emulated click of a stick/button touch.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="animals"
3d_physics/layer_4="interaction"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=3
environment/ssil/quality=2
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.85, 1)

[editor]

export/convert_text_resources_to_binary=false

[shader_globals]

cloud_strength={
"type": "float",
"value": 0.0
}
cloud_scale={
"type": "float",
"value": 0.012
}
cloud_cover={
"type": "float",
"value": 0.35
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
