; Engine configuration file.
; Farm Prototype - step one of a Harvest Moon-like farming game.

config_version=5

[application]

config/name="Farm Town"
config/description="مزرعهٔ شهر / Farm Town — Zamith farm & town life (offline by default; online opt-in)."
run/main_scene="res://scenes/world/Main.tscn"
run/main_scene.farm_boot="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AssetPacks="*res://scripts/v7b1_perf/asset_packs.gd"
PackLoader="*res://scripts/v7b1_platform/pack_loader.gd"
AssetRegistry="*res://scripts/autoload/asset_registry.gd"

GameEvents="*res://scripts/autoload/game_events.gd"
GameData="*res://scripts/autoload/game_data.gd"
TimeManager="*res://scripts/autoload/time_manager.gd"
Economy="*res://scripts/autoload/economy.gd"
Settings="*res://scripts/autoload/settings.gd"
Sfx="*res://scripts/autoload/sfx.gd"
VoiceClient="*res://scripts/autoload/voice_client.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
PowerGrid="*res://scripts/autoload/power_grid.gd"
Friendship="*res://scripts/autoload/friendship.gd"
Needs="*res://scripts/autoload/needs.gd"
Market="*res://scripts/autoload/market.gd"
Ranch="*res://scripts/autoload/ranch.gd"
Net="*res://scripts/net/net.gd"
Lifestyle="*res://scripts/v6a/lifestyle.gd"
WorldMemory="*res://scripts/v6b/world_memory.gd"
CityState="*res://scripts/v7a/city_state.gd"
TownLife="*res://scripts/v7b/town_life.gd"
ControlInput="*res://scripts/v7b1/control_input.gd"
TrafficState="*res://scripts/v7b1_traffic/traffic_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

