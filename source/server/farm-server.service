[Unit]
Description=Farm Town game server (Godot headless, lightweight 4–8 players/room)
After=network-online.target
Wants=network-online.target

[Service]
User=farm
Group=farm
WorkingDirectory=/opt/farm/game
Environment=HOME=/opt/farm
Environment=FARM_SERVER_HOST=YOUR_SERVER_HOST
Environment=FARM_SERVER_PORT=9080
Environment=FARM_SERVER_HEALTH_PORT=9081
; 127.0.0.1 = only nginx (wss on 443) can reach it. Use 0.0.0.0 to open 9080 directly (ws://, no TLS).
Environment=FARM_SERVER_BIND=127.0.0.1
Environment=FARM_CONTENT=/opt/farm/content
Environment=FARM_DATA=/opt/farm/data
Environment=GODOT=/opt/farm/godot
ExecStart=/opt/farm/game/tools/start_server.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/farm/content /opt/farm/data /opt/farm/.local
PrivateTmp=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
