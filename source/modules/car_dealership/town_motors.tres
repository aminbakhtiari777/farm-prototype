cars = [{"id": "city_sedan", "model": "sedan", "en": "City sedan", "fa": "سواری شهری", "price": 900, "color": Color(0.75, 0.1, 0.12, 1), "top_kmh": 55}, {"id": "family_van", "model": "van", "en": "Family van", "fa": "ون خانوادگی", "price": 1300, "color": Color(0.15, 0.3, 0.6, 1), "top_kmh": 48}, {"id": "work_truck", "model": "delivery", "en": "Small truck", "fa": "کامیونت", "price": 1600, "color": Color(0.9, 0.9, 0.88, 1), "top_kmh": 45}]
