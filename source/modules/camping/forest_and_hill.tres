[gd_resource type="Resource" script_class="CampingStyle" format=3]

[ext_resource type="Script" path="res://modules/camping/camping_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "forest_and_hill"
type = "camping"
display_name = "Forest and hill camps"
description = "Two camp spots (pine forest, lookout hill); tent + campfire; a night in the tent fully rests you."
name_fa = "کمپ جنگل و تپه"
spots = [{"id": "pine_forest", "en": "Pine forest camp", "fa": "کمپ جنگل کاج", "pos": Vector2(-64, -97)}, {"id": "lookout_hill", "en": "Lookout hill camp", "fa": "کمپ تپه‌ی چشم‌انداز", "pos": Vector2(64, -104)}]
lines = {"setup": [{"en": "Tent up, fire lit. Listen to the forest...", "fa": "چادر برپا شد، آتش روشن. به صدای جنگل گوش کن..."}], "sleep": [{"en": "You sleep under the stars and wake up fresh.", "fa": "زیر ستاره‌ها می‌خوابی و سرحال بیدار می‌شوی."}], "too_far": [{"en": "Find a camp spot first (forest or lookout hill).", "fa": "اول یک جای کمپ پیدا کن (جنگل یا تپه‌ی چشم‌انداز)."}], "packed": [{"en": "You pack up the tent and put out the fire.", "fa": "چادر را جمع می‌کنی و آتش را خاموش می‌کنی."}]}
