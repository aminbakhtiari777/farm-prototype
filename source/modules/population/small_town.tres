residents = [{"name": "Mina", "surname": "Karimi", "age": 34, "gender": "female", "job": "Barista", "work": "cafe", "home": "maple2", "family": "Karimi", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.78, 0.3, 0.32, 1), "pants": Color(0.2, 0.2, 0.26, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["The coffee is fresh today.", "Four children keep us busy!", "I love this town square."]}, {"name": "Reza", "surname": "Karimi", "age": 37, "gender": "male", "job": "City mail clerk", "work": "city_hall", "home": "maple2", "family": "Karimi", "role": "father", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.25, 0.32, 0.5, 1), "pants": Color(0.15, 0.15, 0.17, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["Letters now go through City Hall.", "Mina makes the best coffee in town.", "Four kids - never a dull day!"]}, {"name": "Ali", "surname": "Karimi", "age": 9, "gender": "male", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "son", "hair": "Hair_SimpleParted", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.6, 0.2, 1), "pants": Color(0.25, 0.3, 0.5, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["We learned about bees today!", "Can I pet your sheep?", "School's out soon!"]}, {"name": "Setareh", "surname": "Karimi", "age": 7, "gender": "female", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.9, 0.45, 0.55, 1), "pants": Color(0.3, 0.25, 0.4, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I drew a horse!", "Ali is too fast on his bike.", "Mum's coffee smells nice."]}, {"name": "Nima", "surname": "Karimi", "age": 5, "gender": "male", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "son", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.3, 0.55, 0.7, 1), "pants": Color(0.2, 0.25, 0.35, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["I can count to twenty!", "Where is the ice cream?", "I want a red balloon."]}, {"name": "Donya", "surname": "Karimi", "age": 4, "gender": "female", "job": "Kindergarten", "work": "school", "home": "maple2", "family": "Karimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.7, 0.5, 1), "pants": Color(0.5, 0.35, 0.45, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Mama!", "Ba!", "Sheep!"]}, {"name": "Dariush", "surname": "Rahimi", "age": 45, "gender": "male", "job": "Police officer", "work": "police", "home": "maple4", "family": "Rahimi", "role": "father", "hair": "Hair_SimpleParted", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.15, 0.2, 0.35, 1), "pants": Color(0.12, 0.14, 0.2, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["All quiet in town.", "Walk safe!", "Keep an eye on your sheep!"]}, {"name": "Leila", "surname": "Rahimi", "age": 42, "gender": "female", "job": "Doctor", "work": "hospital", "home": "maple4", "family": "Rahimi", "role": "mother", "hair": "Hair_SimpleParted", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.92, 0.92, 0.95, 1), "pants": Color(0.5, 0.65, 0.75, 1), "skin": 1, "beard": false, "top": "jacket", "lines": ["Remember to rest when you're tired.", "Drink water, farmer!", "Sima studies medicine, like me."]}, {"name": "Sima", "surname": "Rahimi", "age": 19, "gender": "female", "job": "Student", "work": "university", "home": "maple4", "family": "Rahimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.4, 0.6, 0.8, 1), "pants": Color(0.25, 0.25, 0.3, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["Exams next week...", "The university library is huge.", "Dad worries too much."]}, {"name": "Sara", "surname": "Ahmadi", "age": 29, "gender": "female", "job": "Shopkeeper", "work": "store", "home": "maple3", "family": "Ahmadi", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.5, 0.25, 0.1, 1), "shirt": Color(0.35, 0.55, 0.4, 1), "pants": Color(0.3, 0.25, 0.2, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["We restock seeds every morning.", "Hamid and I just got married.", "Mum loves the mosque garden."]}, {"name": "Hamid", "surname": "Ahmadi", "age": 31, "gender": "male", "job": "Tool repairer", "work": "tool_shop", "home": "maple3", "family": "Ahmadi", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.3, 0.35, 0.4, 1), "pants": Color(0.15, 0.15, 0.18, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["Bring me your broken tools.", "Sara runs a fine shop.", "Anna keeps me busy at the tool shop."]}, {"name": "Parvin", "surname": "Ahmadi", "age": 66, "gender": "female", "job": "Retired teacher", "work": "", "home": "maple3", "family": "Ahmadi", "role": "mother", "hair": "Hair_Buns", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.5, 0.35, 0.5, 1), "pants": Color(0.3, 0.3, 0.32, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["I taught half this town to read.", "The fountain is lovely in the evening.", "Have you met my Sara?"]}, {"name": "Omid", "surname": "Hosseini", "age": 40, "gender": "male", "job": "City Hall manager", "work": "city_hall", "home": "maple5", "family": "Hosseini", "role": "father", "hair": "Hair_SimpleParted", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.4, 0.45, 0.55, 1), "pants": Color(0.2, 0.22, 0.28, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["The city fund is growing.", "Four children keep us busy!", "Come by City Hall anytime."]}, {"name": "Nasrin", "surname": "Hosseini", "age": 38, "gender": "female", "job": "Supermarket cashier", "work": "supermarket", "home": "maple5", "family": "Hosseini", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.7, 0.35, 0.4, 1), "pants": Color(0.2, 0.2, 0.25, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["Specials on tomatoes today.", "Arman helps with the little ones.", "Come by for groceries!"]}]
