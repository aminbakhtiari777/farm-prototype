[gd_resource type="Resource" script_class="PopulationDef" format=3]

[ext_resource type="Script" path="res://modules/population/population_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = "families"
type = "population"
display_name = "Families of the town"
description = "v7b.1: mixed households (large families, newlyweds, elderly, singles). Reza moved from the post office to City Hall; new Bakhtiari, Kia, Houshyar and Soleimani homes."
residents = [{"name": "Mina", "surname": "Karimi", "age": 34, "gender": "female", "job": "Barista", "work": "cafe", "home": "maple2", "family": "Karimi", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.78, 0.3, 0.32, 1), "pants": Color(0.2, 0.2, 0.26, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["The coffee is fresh today.", "Four children keep us busy!", "I love this town square."]}, {"name": "Reza", "surname": "Karimi", "age": 37, "gender": "male", "job": "City mail clerk", "work": "city_hall", "home": "maple2", "family": "Karimi", "role": "father", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.25, 0.32, 0.5, 1), "pants": Color(0.15, 0.15, 0.17, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["Letters now go through City Hall.", "Mina makes the best coffee in town.", "Four kids - never a dull day!"]}, {"name": "Ali", "surname": "Karimi", "age": 9, "gender": "male", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "son", "hair": "Hair_SimpleParted", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.6, 0.2, 1), "pants": Color(0.25, 0.3, 0.5, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["We learned about bees today!", "Can I pet your sheep?", "School's out soon!"]}, {"name": "Setareh", "surname": "Karimi", "age": 7, "gender": "female", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.9, 0.45, 0.55, 1), "pants": Color(0.3, 0.25, 0.4, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I drew a horse!", "Ali is too fast on his bike.", "Mum's coffee smells nice."]}, {"name": "Nima", "surname": "Karimi", "age": 5, "gender": "male", "job": "Pupil", "work": "school", "home": "maple2", "family": "Karimi", "role": "son", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.3, 0.55, 0.7, 1), "pants": Color(0.2, 0.25, 0.35, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["I can count to twenty!", "Where is the ice cream?", "I want a red balloon."]}, {"name": "Donya", "surname": "Karimi", "age": 4, "gender": "female", "job": "Kindergarten", "work": "school", "home": "maple2", "family": "Karimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.7, 0.5, 1), "pants": Color(0.5, 0.35, 0.45, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Mama!", "Ba!", "Sheep!"]}, {"name": "Dariush", "surname": "Rahimi", "age": 45, "gender": "male", "job": "Police officer", "work": "police", "home": "maple4", "family": "Rahimi", "role": "father", "hair": "Hair_SimpleParted", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.15, 0.2, 0.35, 1), "pants": Color(0.12, 0.14, 0.2, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["All quiet in town.", "Walk safe!", "Keep an eye on your sheep!"]}, {"name": "Leila", "surname": "Rahimi", "age": 42, "gender": "female", "job": "Doctor", "work": "hospital", "home": "maple4", "family": "Rahimi", "role": "mother", "hair": "Hair_SimpleParted", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.92, 0.92, 0.95, 1), "pants": Color(0.5, 0.65, 0.75, 1), "skin": 1, "beard": false, "top": "jacket", "lines": ["Remember to rest when you're tired.", "Drink water, farmer!", "Sima studies medicine, like me."]}, {"name": "Sima", "surname": "Rahimi", "age": 19, "gender": "female", "job": "Student", "work": "university", "home": "maple4", "family": "Rahimi", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.4, 0.6, 0.8, 1), "pants": Color(0.25, 0.25, 0.3, 1), "skin": 1, "beard": false, "top": "tshirt", "lines": ["Exams next week...", "The university library is huge.", "Dad worries too much."]}, {"name": "Sara", "surname": "Ahmadi", "age": 29, "gender": "female", "job": "Shopkeeper", "work": "store", "home": "maple3", "family": "Ahmadi", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.5, 0.25, 0.1, 1), "shirt": Color(0.35, 0.55, 0.4, 1), "pants": Color(0.3, 0.25, 0.2, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["We restock seeds every morning.", "Hamid and I just got married.", "Mum loves the mosque garden."]}, {"name": "Hamid", "surname": "Ahmadi", "age": 31, "gender": "male", "job": "Tool repairer", "work": "tool_shop", "home": "maple3", "family": "Ahmadi", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.3, 0.35, 0.4, 1), "pants": Color(0.15, 0.15, 0.18, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["Bring me your broken tools.", "Sara runs a fine shop.", "Anna keeps me busy at the tool shop."]}, {"name": "Parvin", "surname": "Ahmadi", "age": 66, "gender": "female", "job": "Retired teacher", "work": "", "home": "maple3", "family": "Ahmadi", "role": "mother", "hair": "Hair_Buns", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.5, 0.35, 0.5, 1), "pants": Color(0.3, 0.3, 0.32, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["I taught half this town to read.", "The fountain is lovely in the evening.", "Have you met my Sara?"]}, {"name": "Omid", "surname": "Hosseini", "age": 40, "gender": "male", "job": "City Hall manager", "work": "city_hall", "home": "maple5", "family": "Hosseini", "role": "father", "hair": "Hair_SimpleParted", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.4, 0.45, 0.55, 1), "pants": Color(0.2, 0.22, 0.28, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["The city fund is growing.", "Four children keep us busy!", "Come by City Hall anytime."]}, {"name": "Nasrin", "surname": "Hosseini", "age": 38, "gender": "female", "job": "Supermarket cashier", "work": "supermarket", "home": "maple5", "family": "Hosseini", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.7, 0.35, 0.4, 1), "pants": Color(0.2, 0.2, 0.25, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["Specials on tomatoes today.", "Arman helps with the little ones.", "Come by for groceries!"]}, {"name": "Arman", "surname": "Hosseini", "age": 12, "gender": "male", "job": "Pupil", "work": "school", "home": "maple5", "family": "Hosseini", "role": "son", "hair": "Hair_SimpleParted", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.25, 0.45, 0.65, 1), "pants": Color(0.2, 0.25, 0.35, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Football after school!", "I look after my little sisters.", "Dad works at City Hall."]}, {"name": "Niloofar", "surname": "Hosseini", "age": 10, "gender": "female", "job": "Pupil", "work": "school", "home": "maple5", "family": "Hosseini", "role": "daughter", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.85, 0.5, 0.6, 1), "pants": Color(0.3, 0.25, 0.4, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I love reading.", "Niloofar means lotus.", "Mum works at the supermarket."]}, {"name": "Kasra", "surname": "Hosseini", "age": 6, "gender": "male", "job": "Pupil", "work": "school", "home": "maple5", "family": "Hosseini", "role": "son", "hair": "Hair_Buzzed", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.4, 0.6, 0.35, 1), "pants": Color(0.25, 0.3, 0.4, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I can ride a bike!", "Where is the park?", "Yas took my toy."]}, {"name": "Yas", "surname": "Hosseini", "age": 4, "gender": "female", "job": "Kindergarten", "work": "school", "home": "maple5", "family": "Hosseini", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.75, 0.55, 1), "pants": Color(0.55, 0.4, 0.5, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Baba!", "Park!", "Flower!"]}, {"name": "Kian", "surname": "Moradi", "age": 31, "gender": "male", "job": "Fisherman", "work": "pier", "home": "oak12", "family": "Moradi", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.2, 0.4, 0.55, 1), "pants": Color(0.15, 0.2, 0.3, 1), "skin": 1, "beard": true, "top": "tshirt", "lines": ["The catch was good today.", "Shirin and I just moved here.", "Come fishing sometime!"]}, {"name": "Shirin", "surname": "Moradi", "age": 30, "gender": "female", "job": "Fruit seller", "work": "fruit_shop", "home": "oak12", "family": "Moradi", "role": "wife", "hair": "Hair_Long", "hair_color": Color(0.5, 0.25, 0.1, 1), "shirt": Color(0.9, 0.55, 0.35, 1), "pants": Color(0.3, 0.25, 0.2, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["Fresh peaches!", "Kian brings the morning catch.", "We're saving for a baby."]}, {"name": "Bahram", "surname": "Tehrani", "age": 52, "gender": "male", "job": "Carpenter", "work": "carpenter", "home": "oak15", "family": "Tehrani", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.55, 0.4, 0.25, 1), "pants": Color(0.3, 0.25, 0.2, 1), "skin": 0, "beard": true, "top": "jacket", "lines": ["Wood tells you how to cut it.", "Our son studies in Tehran now.", "Come by the workshop."]}, {"name": "Golnar", "surname": "Tehrani", "age": 49, "gender": "female", "job": "Teacher", "work": "school", "home": "oak15", "family": "Tehrani", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.45, 0.35, 0.55, 1), "pants": Color(0.3, 0.3, 0.35, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["The children are learning so fast.", "Bahram still smells of sawdust.", "Tea after class?"]}, {"name": "Hassan", "surname": "Jafari", "age": 58, "gender": "male", "job": "Blacksmith", "work": "blacksmith", "home": "pine9", "family": "Jafari", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.35, 0.3, 0.3, 1), "pants": Color(0.2, 0.2, 0.22, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["The forge is hot today.", "Maryam sews by the window.", "A good hammer lasts a lifetime."]}, {"name": "Maryam", "surname": "Jafari", "age": 54, "gender": "female", "job": "Tailor", "work": "clothing", "home": "pine9", "family": "Jafari", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.55, 0.4, 0.5, 1), "pants": Color(0.3, 0.28, 0.32, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["I can mend that for you.", "Hassan still swings a hammer.", "New fabric arrived!"]}, {"name": "Navid", "surname": "Sadeghi", "age": 35, "gender": "male", "job": "Electrician", "work": "electrical", "home": "harbor2", "family": "Sadeghi", "role": "father", "hair": "Hair_SimpleParted", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.85, 0.75, 0.3, 1), "pants": Color(0.2, 0.2, 0.25, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["Power's steady today.", "Elena and I want kids one day.", "Call me if the lights flicker."]}, {"name": "Elena", "surname": "Sadeghi", "age": 33, "gender": "female", "job": "Nurse", "work": "hospital", "home": "harbor2", "family": "Sadeghi", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.75, 0.6, 0.35, 1), "shirt": Color(0.9, 0.9, 0.95, 1), "pants": Color(0.4, 0.5, 0.65, 1), "skin": 0, "beard": false, "top": "work_shirt", "lines": ["Health first!", "We just painted the house.", "Leila is a wonderful doctor."]}, {"name": "Farhad", "surname": "Rostami", "age": 44, "gender": "male", "job": "Stonemason", "work": "mason", "home": "maple7", "family": "Rostami", "role": "father", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.55, 0.5, 0.45, 1), "pants": Color(0.25, 0.25, 0.28, 1), "skin": 1, "beard": true, "top": "jacket", "lines": ["Stone lasts forever.", "Four children - chaos and joy.", "Need a wall rebuilt?"]}, {"name": "Laleh", "surname": "Rostami", "age": 41, "gender": "female", "job": "Jeweller", "work": "jewelry", "home": "maple7", "family": "Rostami", "role": "mother", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.35, 0.25, 0.4, 1), "pants": Color(0.2, 0.15, 0.25, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["A new ring design today.", "Dara helps with the little ones.", "Come see the shop."]}, {"name": "Dara", "surname": "Rostami", "age": 7, "gender": "male", "job": "Pupil", "work": "school", "home": "maple7", "family": "Rostami", "role": "son", "hair": "Hair_SimpleParted", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.3, 0.5, 0.55, 1), "pants": Color(0.2, 0.25, 0.35, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I found a shiny stone!", "My sisters fight over dolls.", "Dad cuts stone."]}, {"name": "Roya", "surname": "Rostami", "age": 9, "gender": "female", "job": "Pupil", "work": "school", "home": "maple7", "family": "Rostami", "role": "daughter", "hair": "Hair_Long", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.85, 0.4, 0.5, 1), "pants": Color(0.3, 0.25, 0.4, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["I like drawing flowers.", "School was fun!", "Mum makes sparkly things."]}, {"name": "Pouya", "surname": "Rostami", "age": 5, "gender": "male", "job": "Pupil", "work": "school", "home": "maple7", "family": "Rostami", "role": "son", "hair": "Hair_Buzzed", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.4, 0.6, 0.4, 1), "pants": Color(0.25, 0.3, 0.35, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Zoom zoom!", "Can we go to the park?", "Dara is the boss."]}, {"name": "Hana", "surname": "Rostami", "age": 4, "gender": "female", "job": "Kindergarten", "work": "school", "home": "maple7", "family": "Rostami", "role": "daughter", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.95, 0.7, 0.6, 1), "pants": Color(0.55, 0.4, 0.5, 1), "skin": 0, "beard": false, "top": "tshirt", "lines": ["Mama!", "Ball!", "No!"]}, {"name": "Babak", "surname": "Nouri", "age": 39, "gender": "male", "job": "Water engineer", "work": "water_office", "home": "maple1", "family": "Nouri", "role": "husband", "hair": "Hair_SimpleParted", "hair_color": Color(0.35, 0.2, 0.1, 1), "shirt": Color(0.4, 0.6, 0.75, 1), "pants": Color(0.2, 0.25, 0.35, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["The water tower is full.", "Ziba and I like the quiet.", "Report a leak anytime."]}, {"name": "Ziba", "surname": "Nouri", "age": 36, "gender": "female", "job": "Electricity officer", "work": "power_office", "home": "maple1", "family": "Nouri", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.1, 0.07, 0.05, 1), "shirt": Color(0.9, 0.75, 0.3, 1), "pants": Color(0.25, 0.25, 0.3, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["Keep the lights on!", "We're saving for a trip.", "Babak checks the pipes."]}, {"name": "Thomas", "surname": "Bell", "age": 61, "gender": "male", "job": "Priest", "work": "church", "home": "oak10", "family": "Bell", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.85, 0.85, 0.9, 1), "pants": Color(0.2, 0.2, 0.25, 1), "skin": 0, "beard": true, "top": "jacket", "lines": ["Peace be with you.", "Anna sings in the choir.", "The bell tower needs oil."]}, {"name": "Anna", "surname": "Bell", "age": 57, "gender": "female", "job": "Tool seller", "work": "tool_shop", "home": "oak10", "family": "Bell", "role": "wife", "hair": "Hair_Buns", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.55, 0.45, 0.35, 1), "pants": Color(0.3, 0.28, 0.3, 1), "skin": 0, "beard": false, "top": "jacket", "lines": ["A good hoe lasts years.", "Thomas still writes sermons.", "Come by for seeds too."]}, {"name": "Yusuf", "surname": "Haddad", "age": 59, "gender": "male", "job": "Imam", "work": "mosque", "home": "pine14", "family": "Haddad", "role": "husband", "hair": "Hair_Buzzed", "hair_color": Color(0.55, 0.55, 0.55, 1), "shirt": Color(0.3, 0.35, 0.3, 1), "pants": Co