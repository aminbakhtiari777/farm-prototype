[gd_resource type="Resource" script_class="DialogueStyle" format=3]

[ext_resource type="Script" path="res://modules/dialogue/dialogue_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "warm_village"
type = "dialogue"
display_name = "Warm village talk"
description = "Chatty townsfolk: greeting + a line about their job (at work / off work) + family, friendship and health."
greetings = {"morning": {"fa": ["سلام، صبح بخیر!", "صبح بخیر! چطوری؟ خوبی؟", "سلام، صبحت بخیر!"], "en": ["Hello, good morning!", "Morning! How are you? All good?", "Hi, good morning!"]}, "noon": {"fa": ["سلام، چطوری؟ خوبی؟", "روز بخیر!", "سلام! خسته نباشی!"], "en": ["Hello, how are you? Good?", "Good day!", "Hi! Hope work's going well!"]}, "evening": {"fa": ["عصر بخیر!", "سلام، عصرت بخیر! چطوری؟", "سلام! خسته نباشی!"], "en": ["Good evening!", "Hi, good evening! How are you?", "Hi! Long day?"]}, "night": {"fa": ["شب بخیر!", "سلام، دیروقته‌ها!", "شبت بخیر!"], "en": ["Good night!", "Hi, it's getting late!", "Sleep well!"]}}
chat_lines = {"fa": ["سلام، چطوری؟ خوبی؟", "امروز بازار شلوغه!", "نون تازه گرفتی؟", "هوا چه خوبه امروز!", "بچه‌ها خوبن؟", "قیمت گوجه بالا رفته!", "بریم یه چایی بخوریم؟", "شنیدی کشاورز جدید اومده؟"], "en": ["Hi, how are you? All good?", "The market is busy today!", "Did you get fresh bread?", "Lovely weather today!", "How are the kids?", "Tomatoes got pricey!", "Shall we have some tea?", "Heard about the new farmer?"]}
chat_replies = {"fa": ["خوبم، مرسی! تو چطوری؟", "الحمدلله، بد نیستم.", "آره، خیلی!", "ممنون، سلامت باشی.", "حتماً، بریم!", "قربونت، همه خوبن."], "en": ["I'm fine, thanks! And you?", "Thank God, not bad.", "Yes, very!", "Thanks, take care.", "Sure, let's go!", "Thanks, everyone's well."]}
player_greeting = {"fa": ["سلام {player} جان! چطوری؟ خوبی؟", "به‌به، {player}! خوش اومدی."], "en": ["Hi {player}! How are you? Good?", "Oh, {player}! Welcome."]}
job_lines = {"barista": {"work": {"fa": ["قهوه تازه دم کردم، بفرما!", "یه چایی داغ می‌خوری؟"], "en": ["Fresh coffee's ready, have some!", "Fancy a hot tea?"]}, "off": {"fa": ["امروز کافه خیلی شلوغ بود.", "دلم برای یه استراحت تنگ شده."], "en": ["The cafe was packed today.", "I could use a break."]}}, "postman": {"work": {"fa": ["نامه‌ای داری که پست کنم؟", "امروز کلی بسته دارم!"], "en": ["Any letters to send?", "So many parcels today!"]}, "off": {"fa": ["کل شهر رو پیاده رفتم!", "پاهام خسته‌ست."], "en": ["I walked the whole town today!", "My feet are tired."]}}, "pupil": {"work": {"fa": ["سر کلاس درباره زنبورها یاد گرفتیم!", "معلم‌مون خیلی مهربونه."], "en": ["We learned about bees in class!", "Our teacher is really kind."]}, "off": {"fa": ["بیا بریم تا فواره مسابقه!", "می‌شه گوسفندت رو ناز کنم؟"], "en": ["Race you to the fountain!", "Can I pet your sheep?"]}}, "police": {"work": {"fa": ["شهر امن و آرومه.", "مراقب خودت باش!"], "en": ["All quiet and safe in town.", "Stay safe!"]}, "off": {"fa": ["امنیت یعنی همسایه‌ها هوای هم رو داشته باشن.", "امروز یه کیف گمشده پیدا کردم."], "en": ["Safety means neighbours looking out for each other.", "I found a lost wallet today."]}}, "doctor": {"work": {"fa": ["اگه حالت خوب نیست، بیا بیمارستان.", "آب زیاد بخور و خوب بخواب!"], "en": ["If you feel unwell, come to the hospital.", "Drink water and sleep well!"]}, "off": {"fa": ["سلامتی از غذای خوب و خواب کافی شروع می‌شه.", "روزی یه وعده غذای گرم یادت نره!"], "en": ["Health starts with good food and enough sleep.", "Don't forget one warm meal a day!"]}}, "nurse": {"work": {"fa": ["استراحت بهترین داروئه.", "فشارت رو بگیرم؟"], "en": ["Rest is the best medicine.", "Shall I check your blood pressure?"]}, "off": {"fa": ["بعد از شیفت لب ساحل قدم می‌زنم.", "سرماخوردگی این روزها زیاده."], "en": ["I walk on the beach after my shift.", "Lots of colds going around."]}}, "student": {"work": {"fa": ["کتابخونه دانشگاه خیلی بزرگه.", "هفته دیگه امتحان دارم..."], "en": ["The university library is huge.", "Exams next week..."]}, "off": {"fa": ["دارم برای امتحان می‌خونم.", "یه قهوه حسابی لازم دارم!"], "en": ["Studying for exams.", "I need a strong coffee!"]}}, "shopkeeper": {"work": {"fa": ["هر صبح بذر تازه میاریم.", "کود، محصولت رو زودتر می‌رسونه!"], "en": ["We restock seeds every morning.", "Fertilizer makes crops grow faster!"]}, "off": {"fa": ["مغازه رو بستم، دارم می‌رم خونه.", "مامانم باغ مسجد رو خیلی دوست داره."], "en": ["Shop's closed, heading home.", "Mum loves the mosque garden."]}}, "retired": {"work": {"fa": ["نصف این شهر رو من باسواد کردم!", "عصرها کنار فواره قشنگه."], "en": ["I taught half this town to read!", "The fountain is lovely in the evening."]}, "off": {"fa": ["عصرها کنار فواره قشنگه.", "جوون‌ها همیشه عجله دارن!"], "en": ["The fountain is lovely in the evening.", "Young people are always in a hurry!"]}}, "clerk": {"work": {"fa": ["شهرداری از نه تا چهار بازه.", "فهرست اهالی شهر توی شهرداریه."], "en": ["City Hall is open nine to four.", "The town directory is at City Hall."]}, "off": {"fa": ["امروز کلی فرم پر کردم!", "شهردار سلام رسوند."], "en": ["So many forms today!", "The mayor says hello."]}}, "cashier": {"work": {"fa": ["مرغ و تخم‌مرغ تازه داریم!", "نمک و ادویه قفسه آخره."], "en": ["We have fresh chicken and eggs!", "Salt and spices are on the last shelf."]}, "off": {"fa": ["کدو حلوایی پاییز خوب فروش می‌ره.", "آرمان می‌خواد آهنگر بشه."], "en": ["Pumpkins sell well in autumn.", "Arman wants to be a blacksmith."]}}, "fisherman": {"work": {"fa": ["ماهی‌ها امروز خوب نوک می‌زنن!", "طوفان، ماهی قرمز میاره."], "en": ["The fish are biting today!", "Storms bring the red snapper."]}, "off": {"fa": ["ماهی‌هات رو به غرفه ماهی بفروش.", "دریا امروز آروم بود."], "en": ["Sell your fish at the fish stall.", "The sea was calm today."]}}, "fruit": {"work": {"fa": ["سیب باغ خودته؟ خوب می‌خرم!", "یه سبد میوه امتحان کن."], "en": ["Apples from your farm? I'll pay well!", "Try a fruit basket."]}, "off": {"fa": ["کیان ماهی میاره، من میوه!", "میوه تازه یعنی سلامتی."], "en": ["Kian brings fish, I bring fruit!", "Fresh fruit is good health."]}}, "carpenter": {"work": {"fa": ["تخته دونه‌ای بیست سکه.", "خونه پرنده سه تا تخته می‌خواد."], "en": ["Planks are twenty a piece.", "A birdhouse needs three planks."]}, "off": {"fa": ["دستام بوی چوب می‌ده!", "میز مدرسه رو من ساختم."], "en": ["My hands smell of wood!", "I built the school desks."]}}, "teacher": {"work": {"fa": ["خوندن، نوشتن و کشاورزی!", "بچه‌ها امروز خیلی شلوغ کردن."], "en": ["Reading, writing and farming!", "The kids were lively today."]}, "off": {"fa": ["بچه‌ها بازار رو خیلی دوست دارن.", "دارم برگه‌ها رو تصحیح می‌کنم."], "en": ["The children love the market.", "Marking papers tonight."]}}, "blacksmith": {"work": {"fa": ["شمش آهن، شصت سکه.", "کوره امروز داغه!"], "en": ["Iron bars, sixty gold.", "The forge is hot today!"]}, "off": {"fa": ["کوره زمستون‌ها گرمم نگه می‌داره.", "یه فانوس خوب سیم مسی هم می‌خواد."], "en": ["The forge keeps me warm in winter.", "A good lantern needs copper wire too."]}}, "tailor": {"work": {"fa": ["یه پیراهن نو همه‌چیز رو عوض می‌کنه!", "نخ پشمی رو خوب می‌خرم."], "en": ["A new shirt changes everything!", "I pay well for wool yarn."]}, "off": {"fa": ["پیش‌بند حسن همیشه دوده‌ایه!", "دارم یه شال می‌بافم."], "en": ["Hassan's apron is always sooty!", "I'm knitting a scarf."]}}, "electrician": {"work": {"fa": ["سیم مسی، رولی چهل سکه.", "مراقب جعبه فیوز باش!"], "en": ["Copper wire, forty a roll.", "Mind the breaker box!"]}, "off": {"fa": ["اگه برق رفت، صدام کن.", "النا توی بیمارستان کار می‌کنه."], "en": ["If the power goes, call me.", "Elena works at the hospital."]}}, "mason": {"work": {"fa": ["سنگ ساختمونی، دونه‌ای سی سکه.", "مجسمه میدون کار منه."], "en": ["Stone blocks, thirty each.", "I carved the square's statue."]}, "off": {"fa": ["دستام همیشه خاکیه!", "دارا می‌خواد سنگ‌تراش بشه."], "en": ["My hands are always dusty!", "Dara wants to be a mason."]}}, "jewel": {"work": {"fa": ["صدف‌ها جواهرات قشنگی می‌شن.", "یه انگشتر هدیه قشنگیه."], "en": ["Shells make beautiful jewellery.", "A ring makes a lovely gift."]}, "off": {"fa": ["امروز یه گردنبند تموم کردم.", "صدف‌های ساحل رو برام بیار!"], "en": ["I finished a necklace today.", "Bring me shells from the beach!"]}}, "water": {"work": {"fa": ["مخزن این فصل پره.", "آب پاش‌ت رو توی اداره پر می‌کنم."], "en": ["The reservoir is full this season.", "I'll refill your can at the office."]}, "off": {"fa": ["آب سالم یعنی شهر سالم.", "زیبا شبکه برق رو می‌گردونه."], "en": ["Clean water, healthy town.", "Ziba runs the power grid."]}}, "electricity": {"work": {"fa": ["اگه برق رفت، بیا پیش من.", "پست برق تمام روز وزوز می‌کنه."], "en": ["If the power's out, come see me.", "The substation hums all day."]}, "off": {"fa": ["بابک آب شهر رو تأمین می‌کنه.", "امشب برق‌ها روشنه!"], "en": ["Babak keeps the water flowing.", "The lights are on tonight!"]}}, "priest": {"work": {"fa": ["آرامش با تو باشه.", "زنگ کلیسا ساعت نه، دوازده و شش می‌زنه."], "en": ["Peace be with you.", "The bell rings at nine, noon and six."]}, "off": {"fa": ["آنا ابزارفروشی رو می‌گردونه.", "گروه کر امشب تمرین داره."], "en": ["Anna runs the tool shop.", "The choir practises tonight."]}}, "tool": {"work": {"fa": ["ابزار بهتر، محصول بهتر.", "آب‌پاش مسی دوبرابر آب می‌گیره."], "en": ["Better tools, better harvests.", "The copper can holds twice the water."]}, "off": {"fa": ["توماس گروه کر رو دوست داره.", "امروز یه بیل نو فروختم."], "en": ["Thomas loves the choir.", "Sold a new hoe today."]}}, "imam": {"work": {"fa": ["سلام علیکم.", "در مسجد همیشه به روی تو بازه."], "en": ["Peace be upon you.", "The mosque is always open to you."]}, "off": {"fa": ["باغ یوسف بهترین گل‌های رز رو داره.", "انصاف و مهربانی، پایه یه شهر خوبه."], "en": ["My garden has the best roses.", "Fairness and kindness build a good town."]}}, "professor": {"work": {"fa": ["علم خاک واقعاً جذابه.", "دانشجوها توی بازار کمک می‌کنن."], "en": ["Soil science is fascinating.", "Our students help at the market."]}, "off": {"fa": ["یه کتاب خوب درباره کشاورزی دارم.", "یوسف بهترین رزها رو داره."], "en": ["I have a good book on farming.", "Yusuf grows the best roses."]}}, "city mail clerk": {"work": {"fa": ["نامه‌ای داری که پست کنم؟", "امروز کلی بسته دارم!"], "en": ["Any letters to send?", "So many parcels today!"]}, "off": {"fa": ["کل شهر رو پیاده رفتم!", "پاهام خسته‌ست."], "en": ["I walked the whole town today!", "My feet are tired."]}}}
generic_lines = {"work": {"fa": ["کار امروز زیاده!", "سرم شلوغه، ولی خوشحالم دیدمت."], "en": ["Lots of work today!", "Busy, but glad to see you."]}, "off": {"fa": ["شهرمون روز به روز قشنگ‌تر می‌شه.", "امروز روز خوبی بود."], "en": ["Our town gets nicer every day.", "It was a good day."]}}
family_lines = {"fa": ["{name}، {rel}م، همیشه ازت تعریف می‌کنه.", "{rel}م {name} سلام رسوند."], "en": ["{name}, my {rel}, always speaks well of you.", "My {rel} {name} says hello."]}
relations = {"mother": {"fa": ["مادر"], "en": ["mother"]}, "father": {"fa": ["پدر"], "en": ["father"]}, "son": {"fa": ["پسر"], "en": ["son"]}, "daughter": {"fa": ["دختر"], "en": ["daughter"]}, "husband": {"fa": ["همسر"], "en": ["husband"]}, "wife": {"fa": ["همسر"], "en": ["wife"]}, "brother": {"fa": ["برادر"], "en": ["brother"]}, "sister": {"fa": ["خواهر"], "en": ["sister"]}}
friendship_lines = [{"fa": ["تازه به شهر اومدی؟ خوش اومدی!"], "en": ["You're new in town? Welcome!"]}, {"fa": ["خوشحالم دوباره می‌بینمت."], "en": ["Nice to see you again."]}, {"fa": ["دوست خوبم! یه روز بیا خونه‌مون چایی."], "en": ["My good friend! Come over for tea some day."]}, {"fa": ["تو دیگه از خودمونی!"], "en": ["You're one of us now!"]}, {"fa": ["تو مثل خانواده‌ی مایی."], "en": ["You're like family to us."]}]
ill_self = {"fa": ["سرما خوردم... آپچی! باید برم دکتر.", "حالم خوب نیست، فکر کنم سرما خوردم."], "en": ["I've caught a cold... achoo! I should see the doctor.", "I don't feel well, I think it's a cold."]}
ill_player = {"fa": ["رنگت پریده! برو بیمارستان پیش دکتر {doctor}.", "سرما خوردی؟ دکتر {doctor} حالت رو خوب می‌کنه."], "en": ["You look pale! See Dr. {doctor} at the hospital.", "Caught a cold? Dr. {doctor} will fix you up."]}
hungry_player = {"fa": ["گرسنه به نظر میای! یه غذای گرم بخور.", "امروز غذا خوردی؟ روزی یه وعده لازمه."], "en": ["You look hungry! Have a warm meal.", "Have you eaten today? One meal a day at least."]}
tired_player = {"fa": ["خسته به نظر میای، امشب زود بخواب.", "یه کم استراحت کن، سلامتی مهمه."], "en": ["You look tired, sleep early tonight.", "Rest a little - health comes first."]}
closed_lines = {"fa": ["الان بسته‌ایم؛ ساعت {hour} باز می‌کنیم.", "مغازه بسته‌ست، فردا ساعت {hour} بیا."], "en": ["We're closed now; we open at {hour}.", "Shop's closed - come back at {hour}."]}
night_lines = {"fa": ["دیروقته، دارم می‌رم خونه.", "شب بخیر، فردا می‌بینمت."], "en": ["It's late, I'm heading home.", "Good night, see you tomorrow."]}
