[gd_resource type="Resource" script_class="MarketEconomyStyle" format=3]

[ext_resource type="Script" path="res://modules/market_economy/market_economy_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "stable_prices"
type = "market_economy"
display_name = "Stable prices"
description = "A calm market: prices move only a little (x0.85 .. x1.25) and recover fast."
elasticity = 0.15
min_mult = 0.85
max_mult = 1.25
recovery_per_day = 0.6
default_target = 20
buffer_days = 3
retail_markup = 1.5
sell_impact = 0.5
history_days = 7
shortage_below = 0.15
npc_food_basket = {"bread_loaf": 3, "eggs": 3, "rice": 2, "chicken": 1, "tomato_fresh": 2, "onion": 1, "milk": 2, "apple": 1, "sardine": 1, "potato": 1}
