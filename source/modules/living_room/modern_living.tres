[ext_resource type="Script" path="res://modules/living_room/living_room_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "modern_living"
type = "living_room"
display_name = "Modern living room"
description = "1.45 m LCD TV, movable sofa (3 spots), blanket by the window, 2 paintings per home."
name_fa = "اتاق نشیمن مدرن"
paintings = [{"kind": "landscape", "colors": [Color(0.45, 0.65, 0.9, 1), Color(0.35, 0.6, 0.3, 1), Color(0.95, 0.85, 0.5, 1)]}, {"kind": "sunset", "colors": [Color(0.95, 0.55, 0.25, 1), Color(0.6, 0.25, 0.4, 1), Color(0.15, 0.12, 0.2, 1)]}, {"kind": "sea", "colors": [Color(0.2, 0.45, 0.7, 1), Color(0.9, 0.92, 0.95, 1), Color(0.85, 0.75, 0.55, 1)]}, {"kind": "geometric", "colors": [Color(0.15, 0.45, 0.6, 1), Color(0.9, 0.75, 0.3, 1), Color(0.7, 0.2, 0.2, 1)]}, {"kind": "flowers", "colors": [Color(0.95, 0.9, 0.8, 1), Color(0.85, 0.3, 0.4, 1), Color(0.3, 0.55, 0.3, 1)]}]
blanket_colors = [Color(0.75, 0.25, 0.2, 1), Color(0.25, 0.45, 0.6, 1), Color(0.85, 0.7, 0.35, 1), Color(0.4, 0.55, 0.35, 1)]
sofa_slots = [0, -0.9, 0.9]
