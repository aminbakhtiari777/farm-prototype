[gd_resource type="Resource" script_class="TrafficRulesStyle" format=3]

[ext_resource type="Script" path="res://modules/traffic_rules/traffic_rules_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "strict_city"
type = "traffic_rules"
display_name = "Strict city rules"
description = "3 signalised intersections (cameras, officer at Oak/Maple), STOP on Pine Ln at Maple St, limits 30-60 km/h, 2nd offence = licence + car taken."
name_fa = "قوانین سخت شهری"
speed_limits = {"Main St": 40, "Oak Ave": 40, "Maple St": 40, "Pine Ln": 30, "Harbor Rd": 50, "New City Rd": 60}
signals = [{"id": "oak_maple", "pos": Vector2(0, -90), "en": "Oak Ave / Maple St", "fa": "خیابان بلوط / خیابان افرا", "camera": true, "officer": true}, {"id": "pine_main", "pos": Vector2(-45, -50), "en": "Pine Ln / Main St", "fa": "کوچه‌ی کاج / خیابان اصلی", "camera": true, "officer": false}, {"id": "harbor_main", "pos": Vector2(55, -50), "en": "Harbor Rd / Main St", "fa": "جاده‌ی بندر / خیابان اصلی", "camera": true, "officer": false}]
stops = [{"id": "pine_maple", "pos": Vector2(-45, -90), "approaches": ["n", "s"], "en": "Pine Ln / Maple St", "fa": "کوچه‌ی کاج / خیابان افرا"}]
speed_cameras = [{"pos": Vector2(51, -22), "yaw": 180}, {"pos": Vector2(25, -95.6), "yaw": 0}]
officer_lines = {"whistle": [{"en": "Stop! The light is red!", "fa": "ایست! چراغ قرمز است!"}, {"en": "Wait for the green!", "fa": "صبر کن تا سبز شود!"}], "wave": [{"en": "Go ahead, slowly.", "fa": "برو، آرام."}, {"en": "Drive safely!", "fa": "با احتیاط برانید!"}], "caught": [{"en": "Licence and papers, please.", "fa": "گواهینامه و مدارک، لطفاً."}, {"en": "The camera saw everything.", "fa": "دوربین همه چیز را ثبت کرد."}], "ok": [{"en": "Good driving, well done.", "fa": "رانندگی خوب، آفرین."}, {"en": "Thanks for stopping.", "fa": "ممنون که ایستادی."}]}
