[gd_resource type="Resource" script_class="MechanicStyle" format=3]

[ext_resource type="Script" path="res://modules/mechanic/mechanic_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "town_garage"
type = "mechanic"
display_name = "Town garage"
description = "Repairs, fuel pump and four upgrades; open 8-19; a stand-in covers if the mechanic is away."
name_fa = "تعمیرگاه شهر"
upgrades = [{"id": "engine_tune", "en": "Engine tune-up (+12% top speed)", "fa": "تنظیم موتور (۱۲٪ سرعت بیشتر)", "cost": 180, "speed": 1.12, "accel": 1.05, "fuel": 1.05}, {"id": "sport_tyres", "en": "Sport tyres (better grip and pickup)", "fa": "لاستیک اسپرت (چسبندگی و شتاب بهتر)", "cost": 140, "accel": 1.15, "grip": 1.2}, {"id": "led_lights", "en": "LED headlights (see further at night)", "fa": "چراغ ال‌ای‌دی (دید بیشتر در شب)", "cost": 90, "lights": 1.6}, {"id": "eco_injector", "en": "Eco injector (-30% fuel use)", "fa": "انژکتور کم‌مصرف (۳۰٪ مصرف کمتر)", "cost": 120, "fuel": 0.7}]
staff = PackedStringArray("Hassan Jafari", "Babak Nouri")
lines = {"greet": [{"en": "Salam! What's wrong with your car?", "fa": "سلام! ماشینت چه مشکلی دارد؟"}, {"en": "Bring it in, let's have a look.", "fa": "بیاورش داخل، یک نگاهی بیندازیم."}], "repaired": [{"en": "Good as new. Drive gently!", "fa": "مثل روز اولش شد. آرام رانندگی کن!"}], "fueled": [{"en": "Full tank - safe travels.", "fa": "باک پر شد - سفر به خیر."}], "upgraded": [{"en": "Installed. You'll feel the difference.", "fa": "نصب شد. فرقش را حس می‌کنی."}], "standin": [{"en": "The mechanic is away - I'm minding the shop.", "fa": "مکانیک نیست - من حواسم به مغازه هست."}], "poor": [{"en": "Not enough money - come back later.", "fa": "پولت کافی نیست - بعداً بیا."}]}
