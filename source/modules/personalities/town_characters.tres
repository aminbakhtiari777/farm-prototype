[gd_resource type="Resource" script_class="PersonalityStyle" format=3]

[ext_resource type="Script" path="res://modules/personalities/personality_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "town_characters"
type = "personalities"
display_name = "Town characters"
description = "Six characters (calm, hot-tempered, generous, stingy, cheerful, shy) shape arguments and haggling."
name_fa = "شخصیت‌های شهر"
traits = {"calm": {"en": "calm", "fa": "آرام", "temper": 0.1, "haggle": 0.3, "generosity": 0.5, "patience": 3, "argue": [{"en": "Let's talk about this calmly.", "fa": "بیا آرام درباره‌اش حرف بزنیم."}], "reply": [{"en": "I understand, but...", "fa": "می‌فهمم، ولی..."}], "accept": [{"en": "That's fair. Deal.", "fa": "منصفانه است. قبول."}], "refuse": [{"en": "Sorry, that's too much for me.", "fa": "ببخشید، این برای من زیاد است."}], "counter": [{"en": "How about {price}?", "fa": "{price} چطور است؟"}]}, "hot_tempered": {"en": "hot-tempered", "fa": "تندخو", "temper": 0.85, "haggle": 0.6, "generosity": 0.3, "patience": 1, "argue": [{"en": "I've had enough of this!", "fa": "دیگر خسته شدم!"}, {"en": "Don't you dare!", "fa": "جرئت داری تکرار کن!"}], "reply": [{"en": "You're always like this!", "fa": "تو همیشه همینی!"}], "accept": [{"en": "Fine. Take it.", "fa": "باشه. بگیر."}], "refuse": [{"en": "Are you joking?! No!", "fa": "شوخی می‌کنی؟! نه!"}], "counter": [{"en": "{price}, and not a coin more!", "fa": "{price}، یک سکه هم بیشتر نه!"}]}, "generous": {"en": "generous", "fa": "دست‌ودل‌باز", "temper": 0.2, "haggle": 0.1, "generosity": 0.9, "patience": 3, "argue": [{"en": "Forget it, it's not worth a fight.", "fa": "ولش کن، ارزش دعوا ندارد."}], "reply": [{"en": "No hard feelings.", "fa": "دلخوری نیست."}], "accept": [{"en": "Of course! And here's a little extra.", "fa": "البته! این هم کمی بیشتر."}], "refuse": [{"en": "I really can't, sorry.", "fa": "واقعاً نمی‌توانم، ببخشید."}], "counter": [{"en": "Let's say {price} - you work hard.", "fa": "بگوییم {price} - تو زحمت می‌کشی."}]}, "stingy": {"en": "stingy", "fa": "خسیس", "temper": 0.5, "haggle": 0.9, "generosity": 0.05, "patience": 2, "argue": [{"en": "Every coin counts!", "fa": "هر سکه حساب دارد!"}], "reply": [{"en": "I won't pay a coin more!", "fa": "یک سکه هم بیشتر نمی‌دهم!"}], "accept": [{"en": "Hmm... all right. But only this once.", "fa": "هوم... باشه. فقط همین یک بار."}], "refuse": [{"en": "Too expensive! Robbery!", "fa": "خیلی گران است! دزدی است!"}], "counter": [{"en": "{price}. Take it or leave it.", "fa": "{price}. می‌خواهی بخواه، نمی‌خواهی نخواه."}]}, "cheerful": {"en": "cheerful", "fa": "خوش‌رو", "temper": 0.25, "haggle": 0.4, "generosity": 0.6, "patience": 3, "argue": [{"en": "Come on, let's not fight!", "fa": "بی‌خیال، دعوا نکنیم!"}], "reply": [{"en": "Ha, you're right, sorry!", "fa": "ها، حق با توست، ببخشید!"}], "accept": [{"en": "Deal! Nice doing business.", "fa": "قبول! معامله با تو خوش است."}], "refuse": [{"en": "Ha, nice try! Too much.", "fa": "ها، تلاش خوبی بود! زیاد است."}], "counter": [{"en": "Meet me at {price}?", "fa": "روی {price} توافق کنیم؟"}]}, "shy": {"en": "shy", "fa": "خجالتی", "temper": 0.15, "haggle": 0.2, "generosity": 0.5, "patience": 2, "argue": [{"en": "Um... please stop.", "fa": "اِ... لطفاً بس کن."}], "reply": [{"en": "I... I didn't mean it.", "fa": "من... منظوری نداشتم."}], "accept": [{"en": "Okay... thank you.", "fa": "باشه... ممنون."}], "refuse": [{"en": "Sorry... I can't.", "fa": "ببخشید... نمی‌توانم."}], "counter": [{"en": "Maybe... {price}?", "fa": "شاید... {price}؟"}]}}
people = {"Mina Karimi": "cheerful", "Reza Karimi": "hot_tempered", "Dariush Rahimi": "calm", "Leila Rahimi": "calm", "Sima Rahimi": "shy", "Sara Ahmadi": "stingy", "Parvin Ahmadi": "generous", "Omid Hosseini": "calm", "Nasrin Hosseini": "cheerful", "Kian Moradi": "hot_tempered", "Shirin Moradi": "generous", "Bahram Tehrani": "stingy", "Golnar Tehrani": "calm", "Hassan Jafari": "hot_tempered", "Maryam Jafari": "generous", "Navid Sadeghi": "cheerful", "Elena Sadeghi": "calm", "Farhad Rostami": "hot_tempered", "Laleh Rostami": "stingy", "Babak Nouri": "shy", "Ziba Nouri": "cheerful", "Thomas Bell": "generous", "Anna Bell": "cheerful", "Yusuf Haddad": "generous", "Amina Haddad": "calm", "Ali Karimi": "cheerful", "Arman Hosseini": "shy", "Dara Rostami": "cheerful"}
