[gd_resource type="Resource" script_class="ChatterStyle" format=3]

[ext_resource type="Script" path="res://modules/chatter/chatter_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "quiet_town"
type = "chatter"
display_name = "Quiet town"
description = "People mostly keep to themselves: rare remarks, reactions only to big events."
name_fa = "شهر کم‌حرف"
remarks = {"idle_morning": [{"en": "Good morning! Fresh bread at the market today.", "fa": "صبح بخیر! امروز نان تازه در بازار هست."}, {"en": "I slept well - the air was cool last night.", "fa": "دیشب خوب خوابیدم - هوا خنک بود."}, {"en": "Time for a walk before work.", "fa": "قبل از کار یک پیاده‌روی بچسبد."}, {"en": "Breakfast first, then the day.", "fa": "اول صبحانه، بعد کار و زندگی."}], "idle_evening": [{"en": "What a long day... tea, anyone?", "fa": "چه روز درازی... کسی چای می‌خورد؟"}, {"en": "The terrace cafe has music tonight.", "fa": "امشب کافه‌ی تراس موسیقی دارد."}, {"en": "I'm off home, the kids are waiting.", "fa": "می‌روم خانه، بچه‌ها منتظرند."}, {"en": "Look at that sunset!", "fa": "غروب را ببین!"}], "rain": [{"en": "Did anyone bring an umbrella?", "fa": "کسی چتر آورده؟"}, {"en": "Good rain for the gardens.", "fa": "باران خوبی برای باغچه‌هاست."}, {"en": "My shoes are soaked!", "fa": "کفش‌هایم خیس آب شد!"}], "storm": [{"en": "Hold on to your hat - what wind!", "fa": "کلاهت را محکم بگیر - چه بادی!"}, {"en": "Stay away from the power lines.", "fa": "از سیم‌های برق دور بمانید."}, {"en": "I hope the boats are tied up.", "fa": "امیدوارم قایق‌ها را بسته باشند."}], "snow": [{"en": "Snow! The kids will be happy.", "fa": "برف! بچه‌ها خوشحال می‌شوند."}, {"en": "Careful, the street is slippery.", "fa": "مراقب باش، خیابان لیز است."}], "heatwave": [{"en": "So hot - drink water, everyone!", "fa": "چه گرمایی - همه آب بخورید!"}, {"en": "I'll stay in the shade today.", "fa": "امروز زیر سایه می‌مانم."}], "sunny": [{"en": "Lovely weather today.", "fa": "امروز هوا عالی است."}, {"en": "Perfect day for the beach.", "fa": "یک روز عالی برای ساحل."}], "fire": [{"en": "Fire! Someone call 125!", "fa": "آتش! یکی به ۱۲۵ زنگ بزند!"}, {"en": "Is everyone out of the house?", "fa": "همه از خانه بیرون آمدند؟"}, {"en": "The fire truck is coming, make way!", "fa": "ماشین آتش‌نشانی دارد می‌آید، راه را باز کنید!"}], "outage": [{"en": "The power is out again...", "fa": "باز هم برق رفت..."}, {"en": "Good thing I have candles.", "fa": "خوب شد شمع دارم."}, {"en": "The electricity crew is on the way.", "fa": "گروه برق در راه است."}], "power_back": [{"en": "The lights are back!", "fa": "برق آمد!"}, {"en": "Well done, electricity crew.", "fa": "دست گروه برق درد نکند."}], "quake": [{"en": "Did you feel that?!", "fa": "حس کردی؟!"}, {"en": "Earthquake! Stay calm, stay outside.", "fa": "زلزله! آرام باشید، بیرون بمانید."}, {"en": "Everyone okay? Check on the neighbours.", "fa": "همه خوبند؟ به همسایه‌ها سر بزنید."}], "project": [{"en": "The city is building something new!", "fa": "شهرداری دارد چیز تازه‌ای می‌سازد!"}, {"en": "So that's where our fines go.", "fa": "پس جریمه‌ها اینجا خرج می‌شود."}], "project_done": [{"en": "The new work is finished - looks great.", "fa": "کار تازه تمام شد - خیلی قشنگ شده."}, {"en": "A nice change for the town.", "fa": "تغییر خوبی برای شهر است."}], "fine": [{"en": "Someone got fined - rules are rules.", "fa": "یکی جریمه شد - قانون قانون است."}, {"en": "Fair is fair, the fund needs it.", "fa": "انصاف همین است، صندوق شهر لازمش دارد."}], "argument": [{"en": "Not again, those two...", "fa": "باز این دو نفر..."}, {"en": "Someone should calm them down.", "fa": "یکی باید آرامشان کند."}], "cafe_fight": [{"en": "A scuffle at the cafe!", "fa": "دعوا در کافه!"}, {"en": "That's what too many strong drinks do.", "fa": "نتیجه‌ی نوشیدنی قوی زیادی همین است."}], "player_fast": [{"en": "Slow down! Children play here!", "fa": "آرام‌تر! اینجا بچه‌ها بازی می‌کنند!"}, {"en": "Hey, this isn't a race track!", "fa": "آهای، اینجا پیست مسابقه نیست!"}], "player_horn": [{"en": "All right, all right, I heard you!", "fa": "باشه، باشه، شنیدم!"}, {"en": "No need to honk!", "fa": "بوق زدن لازم نیست!"}], "player_possess": [{"en": "You seem different today...", "fa": "امروز یک جوری شده‌ای..."}, {"en": "Are you feeling all right?", "fa": "حالت خوب است؟"}], "passenger": [{"en": "Look, the farmer gives rides now.", "fa": "ببین، کشاورز حالا مسافر هم می‌برد."}, {"en": "Handy - a ride for a few coins.", "fa": "چه خوب - با چند سکه می‌شود سوار شد."}], "newspaper": [{"en": "Did you read today's paper?", "fa": "روزنامه‌ی امروز را خواندی؟"}, {"en": "The paper says the fund is growing.", "fa": "روزنامه نوشته صندوق شهر بزرگ‌تر شده."}], "camping": [{"en": "Going camping? Take warm clothes.", "fa": "به کمپ می‌روی؟ لباس گرم ببر."}, {"en": "Nights in the forest are beautiful.", "fa": "شب‌های جنگل قشنگ است."}], "night_no_lights": [{"en": "Turn your lights on! I can't see you!", "fa": "چراغ‌هایت را روشن کن! نمی‌بینمت!"}]}
dialogues = [{"topic": "weather", "lines": [{"en": "Will it rain tomorrow?", "fa": "فردا باران می‌آید؟"}, {"en": "The fishermen say so.", "fa": "ماهیگیرها که این را می‌گویند."}, {"en": "Then I'll water the garden less.", "fa": "پس کمتر باغچه را آب می‌دهم."}]}, {"topic": "fund", "lines": [{"en": "Did you see the city fund board?", "fa": "تابلوی صندوق شهر را دیدی؟"}, {"en": "Yes, they want to build a park.", "fa": "آره، می‌خواهند پارک بسازند."}, {"en": "Good - the kids need it.", "fa": "خوب است - بچه‌ها لازمش دارند."}]}, {"topic": "prices", "lines": [{"en": "Tomatoes got expensive again.", "fa": "گوجه دوباره گران شد."}, {"en": "Wait for the harvest, it'll drop.", "fa": "صبر کن فصل برداشت شود، ارزان می‌شود."}, {"en": "I hope so, my wallet is crying.", "fa": "امیدوارم، جیبم دارد گریه می‌کند."}]}, {"topic": "family", "lines": [{"en": "How is your mother?", "fa": "مادرت چطور است؟"}, {"en": "Better, thank God. The doctor helped.", "fa": "بهتر است، خدا را شکر. دکتر کمک کرد."}, {"en": "Give her my regards.", "fa": "سلام مرا برسان."}]}, {"topic": "cafe", "lines": [{"en": "Coming to the terrace tonight?", "fa": "امشب می‌آیی تراس؟"}, {"en": "Only for tea - I work early.", "fa": "فقط برای چای - صبح زود کار دارم."}, {"en": "Sensible. The DJ starts at seven.", "fa": "عاقلانه است. دی‌جی ساعت هفت شروع می‌کند."}]}, {"topic": "news", "lines": [{"en": "Did you read about the fire?", "fa": "خبر آتش‌سوزی را خواندی؟"}, {"en": "Yes, thank God nobody was hurt.", "fa": "آره، خدا را شکر کسی آسیب ندید."}, {"en": "The firefighters were fast.", "fa": "آتش‌نشان‌ها سریع رسیدند."}]}, {"topic": "work", "lines": [{"en": "Busy day at work?", "fa": "سر کار شلوغ بود؟"}, {"en": "Very. But it's honest work.", "fa": "خیلی. ولی کار شرافتمندانه است."}, {"en": "That's what matters.", "fa": "مهم همین است."}]}, {"topic": "health", "lines": [{"en": "I've started walking every morning.", "fa": "هر صبح پیاده‌روی را شروع کرده‌ام."}, {"en": "Good for you! I go to the gym.", "fa": "آفرین! من باشگاه می‌روم."}, {"en": "Health is wealth, my father said.", "fa": "پدرم می‌گفت سلامتی بزرگ‌ترین ثروت است."}]}]
remark_interval = Vector2(70, 120)
overhear_interval = Vector2(90, 160)
react_chance = 0.4
