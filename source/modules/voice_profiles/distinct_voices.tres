[gd_resource type="Resource" script_class="VoiceProfileStyle" format=3]

[ext_resource type="Script" path="res://modules/voice_profiles/voice_profile_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "distinct_voices"
type = "voice_profiles"
display_name = "Distinct voices"
description = "28 personal voice profiles (pitch, rate, tone) and tone-specific Persian small talk."
name_fa = "صداهای متمایز"
people = {"Mina Karimi": {"pitch": 1.3, "rate": 1.15, "tone": "bright"}, "Reza Karimi": {"pitch": 0.8, "rate": 1.1, "tone": "lively"}, "Ali Karimi": {"pitch": 1.75, "rate": 1.25, "tone": "lively"}, "Dariush Rahimi": {"pitch": 0.72, "rate": 0.9, "tone": "slow"}, "Leila Rahimi": {"pitch": 1.18, "rate": 0.95, "tone": "warm"}, "Sima Rahimi": {"pitch": 1.38, "rate": 1.05, "tone": "soft"}, "Sara Ahmadi": {"pitch": 1.26, "rate": 1.2, "tone": "bright"}, "Parvin Ahmadi": {"pitch": 1.08, "rate": 0.8, "tone": "warm"}, "Omid Hosseini": {"pitch": 0.86, "rate": 1, "tone": "slow"}, "Nasrin Hosseini": {"pitch": 1.24, "rate": 1.1, "tone": "warm"}, "Arman Hosseini": {"pitch": 1.62, "rate": 1.1, "tone": "soft"}, "Kian Moradi": {"pitch": 0.78, "rate": 1.05, "tone": "gruff"}, "Shirin Moradi": {"pitch": 1.32, "rate": 1.05, "tone": "warm"}, "Bahram Tehrani": {"pitch": 0.7, "rate": 0.9, "tone": "gruff"}, "Golnar Tehrani": {"pitch": 1.12, "rate": 0.95, "tone": "slow"}, "Hassan Jafari": {"pitch": 0.66, "rate": 0.85, "tone": "gruff"}, "Maryam Jafari": {"pitch": 1.1, "rate": 0.9, "tone": "warm"}, "Navid Sadeghi": {"pitch": 0.9, "rate": 1.2, "tone": "lively"}, "Elena Sadeghi": {"pitch": 1.22, "rate": 0.95, "tone": "soft"}, "Farhad Rostami": {"pitch": 0.68, "rate": 1, "tone": "gruff"}, "Laleh Rostami": {"pitch": 1.2, "rate": 1.1, "tone": "bright"}, "Dara Rostami": {"pitch": 1.85, "rate": 1.3, "tone": "lively"}, "Babak Nouri": {"pitch": 0.84, "rate": 0.9, "tone": "soft"}, "Ziba Nouri": {"pitch": 1.28, "rate": 1.15, "tone": "lively"}, "Thomas Bell": {"pitch": 0.76, "rate": 0.85, "tone": "warm"}, "Anna Bell": {"pitch": 1.06, "rate": 1, "tone": "bright"}, "Yusuf Haddad": {"pitch": 0.74, "rate": 0.8, "tone": "slow"}, "Amina Haddad": {"pitch": 1.04, "rate": 1, "tone": "slow"}}
tones = {"warm": {"en": "warm", "fa": "گرم", "volume_db": 0, "jitter": 0.05}, "bright": {"en": "bright", "fa": "روشن", "volume_db": 1, "jitter": 0.09}, "gruff": {"en": "gruff", "fa": "خش‌دار", "volume_db": 1.5, "jitter": 0.03}, "soft": {"en": "soft", "fa": "نرم", "volume_db": -4, "jitter": 0.04}, "lively": {"en": "lively", "fa": "پرشور", "volume_db": 1, "jitter": 0.12}, "slow": {"en": "slow", "fa": "شمرده", "volume_db": -1, "jitter": 0.03}}
tone_lines = {"warm": [{"en": "Come by for tea sometime, dear.", "fa": "یک وقت برای چای سر بزن، عزیزم."}, {"en": "How's your family? Well, I hope.", "fa": "خانواده خوبند؟ امیدوارم خوب باشند."}], "bright": [{"en": "Oh! What a beautiful day!", "fa": "وای! چه روز قشنگی!"}, {"en": "Guess what I heard today!", "fa": "حدس بزن امروز چه شنیدم!"}], "gruff": [{"en": "Hmph. Work doesn't do itself.", "fa": "هوم. کار خودش انجام نمی‌شود."}, {"en": "Back in my day, we walked everywhere.", "fa": "زمان ما همه‌جا پیاده می‌رفتیم."}], "soft": [{"en": "Oh... hello. Nice to see you.", "fa": "اوه... سلام. خوشحالم می‌بینمت."}, {"en": "It's peaceful today, isn't it?", "fa": "امروز آرام است، نه؟"}], "lively": [{"en": "Let's go, let's go! So much to do!", "fa": "بزن بریم! کلی کار داریم!"}, {"en": "Ha! You should've seen it!", "fa": "ها! باید می‌دیدی!"}], "slow": [{"en": "Patience... everything in its time.", "fa": "صبر... هر چیزی وقتی دارد."}, {"en": "As Hafez says, be kind.", "fa": "به قول حافظ، مهربان باش."}]}
