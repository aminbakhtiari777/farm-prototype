[resource]
script = ExtResource("1")
id = "late_night"
type = "shop_hours"
display_name = "Late-night town"
description = "Longer evening hours: supermarket until midnight, cafe 6-23."
hours = {"store": [7, 22], "supermarket": [7, 24], "grocery": [7, 24], "cafe": [6, 23], "carpenter": [8, 17], "blacksmith": [8, 17], "mason": [8, 17], "fruit_shop": [7, 22], "clothing": [9, 18], "jewelry": [9, 18], "tool_shop": [8, 18], "electrical": [8, 18], "water_office": [8, 16], "power_office": [8, 16], "city_hall": [9, 16], "post": [8, 16], "market": [6, 22], "workshop": [0, 24]}
default_hours = [8, 20]
always_open = PackedStringArray("hospital", "doctor", "workshop", "home")
