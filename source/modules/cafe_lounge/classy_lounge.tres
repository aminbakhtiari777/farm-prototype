[ext_resource type="Script" path="res://modules/cafe_lounge/cafe_lounge_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "classy_lounge"
type = "cafe_lounge"
display_name = "Classy lounge + disco"
description = "Stone terrace, pergola lights, plants; indoor lounge with a disco 20-24, crowd of 12, modest stylish dress code."
