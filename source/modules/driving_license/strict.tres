[gd_resource type="Resource" script_class="LicenseStyle" format=3]

[ext_resource type="Script" path="res://modules/driving_license/license_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "strict"
type = "driving_license"
display_name = "Strict exam"
description = "All 10 questions, 9 to pass, fee 40, 3-day confiscation, impound fee 200."
name_fa = "امتحان سخت"
pages = [{"title": {"en": "1. Traffic lights", "fa": "۱. چراغ راهنمایی"}, "lines": [{"en": "Red: stop before the white stop line and wait. Never cross on red.", "fa": "قرمز: پشت خط ایست سفید بایست و صبر کن. هرگز با چراغ قرمز رد نشو."}, {"en": "At red you wait about 5 seconds or more - then the light turns green for you.", "fa": "پشت چراغ قرمز حدود ۵ ثانیه یا بیشتر صبر می‌کنی - بعد چراغ برایت سبز می‌شود."}, {"en": "Yellow: stop if you safely can. Green: go, but give way to people on the crossing.", "fa": "زرد: اگر می‌توانی با اطمینان بایست. سبز: برو، ولی به عابران روی خط عابر راه بده."}]}, {"title": {"en": "2. STOP signs", "fa": "۲. تابلوی ایست"}, "lines": [{"en": "At a STOP sign come to a full stop at the line for about 5 seconds.", "fa": "سر تابلوی ایست کاملاً پشت خط بایست، حدود ۵ ثانیه."}, {"en": "Then go when the road is clear. Rolling through is a fine.", "fa": "بعد وقتی راه خالی بود برو. رد شدن بدون توقف جریمه دارد."}]}, {"title": {"en": "3. Speed limits", "fa": "۳. محدودیت سرعت"}, "lines": [{"en": "Main St, Oak Ave, Maple St: 40 km/h. Pine Ln: 30. Harbor Rd: 50. New City Rd: 60.", "fa": "خیابان اصلی، بلوط و افرا: ۴۰ کیلومتر. کوچه‌ی کاج: ۳۰. جاده‌ی بندر: ۵۰. جاده‌ی شهر جدید: ۶۰."}, {"en": "Around the square and near the school: 25 km/h.", "fa": "دور میدان و کنار مدرسه: ۲۵ کیلومتر."}, {"en": "The round sign with the red ring shows the limit; your dashboard shows it too.", "fa": "تابلوی گرد با حلقه‌ی قرمز سرعت مجاز را نشان می‌دهد؛ داشبورد هم نشانش می‌دهد."}]}, {"title": {"en": "4. Cameras and the officer", "fa": "۴. دوربین‌ها و پلیس راهنمایی"}, "lines": [{"en": "Cameras at the main junctions photograph red-light runners and speeders.", "fa": "دوربین‌های تقاطع‌های اصلی از کسانی که چراغ قرمز را رد می‌کنند یا تند می‌روند عکس می‌گیرند."}, {"en": "Every fine goes to the city fund. The police file a report and the paper prints it.", "fa": "همه‌ی جریمه‌ها به صندوق شهرداری می‌رود. پلیس گزارش می‌نویسد و روزنامه چاپش می‌کند."}]}, {"title": {"en": "5. Licence points", "fa": "۵. نمره‌ی منفی و توقیف"}, "lines": [{"en": "The 2nd offence: your licence is confiscated and your car is towed to the impound lot.", "fa": "تخلف دوم: گواهینامه‌ات توقیف و ماشینت به پارکینگ توقیف برده می‌شود."}, {"en": "After 2 days you can retake the test; then pay the fee to get the car back.", "fa": "بعد از ۲ روز می‌توانی دوباره امتحان بدهی؛ بعد با پرداخت هزینه ماشین را پس بگیری."}, {"en": "Driving without a licence is also an offence.", "fa": "رانندگی بدون گواهینامه هم تخلف است."}]}, {"title": {"en": "6. Courtesy", "fa": "۶. ادب رانندگی"}, "lines": [{"en": "Drive on the right. Park only in the parking bays, never on crossings or by NO PARKING signs.", "fa": "از سمت راست برو. فقط در جای پارک بایست، نه روی خط عابر و نه کنار تابلوی توقف ممنوع."}, {"en": "Headlights on at night (H). Give way at the roundabout - traffic inside goes first.", "fa": "شب‌ها چراغ روشن (H). در میدان راه بده - ماشین‌های داخل میدان حق تقدم دارند."}, {"en": "Never drive after strong drinks.", "fa": "بعد از نوشیدنی قوی هرگز رانندگی نکن."}]}]
questions = [{"q": {"en": "The light is red. What do you do?", "fa": "چراغ قرمز است. چه می‌کنی؟"}, "options": [{"en": "Stop behind the stop line and wait", "fa": "پشت خط ایست می‌ایستم و صبر می‌کنم"}, {"en": "Go if nobody is coming", "fa": "اگر کسی نیامد رد می‌شوم"}, {"en": "Honk and go", "fa": "بوق می‌زنم و می‌روم"}], "answer": 0}, {"q": {"en": "At a STOP sign you must...", "fa": "سر تابلوی ایست باید..."}, "options": [{"en": "Slow down a little", "fa": "کمی آهسته کنم"}, {"en": "Stop completely for about 5 seconds", "fa": "حدود ۵ ثانیه کاملاً بایستم"}, {"en": "Only stop at night", "fa": "فقط شب بایستم"}], "answer": 1}, {"q": {"en": "Speed limit on Main St?", "fa": "سرعت مجاز خیابان اصلی؟"}, "options": [{"en": "25 km/h", "fa": "۲۵ کیلومتر"}, {"en": "40 km/h", "fa": "۴۰ کیلومتر"}, {"en": "60 km/h", "fa": "۶۰ کیلومتر"}], "answer": 1}, {"q": {"en": "Speed limit near the school?", "fa": "سرعت مجاز کنار مدرسه؟"}, "options": [{"en": "25 km/h", "fa": "۲۵ کیلومتر"}, {"en": "50 km/h", "fa": "۵۰ کیلومتر"}, {"en": "No limit", "fa": "محدودیت ندارد"}], "answer": 0}, {"q": {"en": "Where do traffic fines go?", "fa": "جریمه‌های رانندگی کجا می‌رود؟"}, "options": [{"en": "To the officer", "fa": "به جیب مأمور"}, {"en": "To the city fund", "fa": "به صندوق شهرداری"}, {"en": "Nowhere", "fa": "هیچ‌جا"}], "answer": 1}, {"q": {"en": "What happens at your 2nd offence?", "fa": "در تخلف دوم چه می‌شود؟"}, "options": [{"en": "Nothing", "fa": "هیچ"}, {"en": "A warning", "fa": "یک تذکر"}, {"en": "Licence confiscated, car impounded", "fa": "گواهینامه توقیف و ماشین به پارکینگ می‌رود"}], "answer": 2}, {"q": {"en": "The light turns yellow and you can stop safely.", "fa": "چراغ زرد شد و می‌توانی با اطمینان بایستی."}, "options": [{"en": "Speed up", "fa": "گاز می‌دهم"}, {"en": "Stop", "fa": "می‌ایستم"}, {"en": "Flash my lights", "fa": "چراغ می‌زنم"}], "answer": 1}, {"q": {"en": "Entering the roundabout at the square:", "fa": "ورود به میدان شهر:"}, "options": [{"en": "Traffic inside goes first", "fa": "ماشین‌های داخل میدان حق تقدم دارند"}, {"en": "I go first", "fa": "من اول می‌روم"}, {"en": "The bigger car goes first", "fa": "ماشین بزرگ‌تر اول می‌رود"}], "answer": 0}, {"q": {"en": "At night you drive with...", "fa": "شب با ... رانندگی می‌کنی"}, "options": [{"en": "Headlights on", "fa": "چراغ روشن"}, {"en": "Lights off to save fuel", "fa": "چراغ خاموش برای صرفه‌جویی"}, {"en": "Hazard lights only", "fa": "فقط فلاشر"}], "answer": 0}, {"q": {"en": "After strong drinks at the cafe:", "fa": "بعد از نوشیدنی قوی در کافه:"}, "options": [{"en": "I drive slowly", "fa": "آهسته رانندگی می‌کنم"}, {"en": "I don't drive", "fa": "رانندگی نمی‌کنم"}, {"en": "I drive on Pine Ln only", "fa": "فقط در کوچه‌ی کاج می‌رانم"}], "answer": 1}]
quiz_count = 10
pass_mark = 9
test_fee = 40
confiscation_days = 3
impound_fee = 200
