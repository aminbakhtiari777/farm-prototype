[gd_resource type="Resource" script_class="BackstoryStyle" format=3]

[ext_resource type="Script" path="res://modules/backstories/backstory_style.gd" id="1"]

[resource]
script = ExtResource("1")
id = "town_stories"
type = "backstories"
display_name = "Town life stories"
description = "28 residents with talents, a current problem, a past hardship and a hope; memories of you come up in talks."
name_fa = "داستان زندگی مردم شهر"
people = {"Mina Karimi": {"talents_en": "latte art, remembering every regular's order", "talents_fa": "طراحی روی قهوه، یادش می‌ماند هر مشتری چه می‌خورد", "problem_en": "the cafe's old espresso machine keeps breaking", "problem_fa": "دستگاه قهوه‌ی قدیمی کافه مدام خراب می‌شود", "past_en": "she lost her first cafe to a flood years ago and started again here", "past_fa": "سال‌ها پیش کافه‌ی اولش را سیل برد و اینجا از نو شروع کرد", "hope_en": "to open a small bakery corner", "hope_fa": "یک گوشه‌ی کوچک نانوایی راه بیندازد"}, "Reza Karimi": {"talents_en": "knows every street by heart, fixes bicycles", "talents_fa": "همه‌ی کوچه‌ها را از بر است، دوچرخه تعمیر می‌کند", "problem_en": "his knee still hurts from the old delivery rounds", "problem_fa": "از مسیرهای قدیمی پست، زانویش هنوز درد می‌کند", "past_en": "he grew up without a father and worked since he was fourteen", "past_fa": "بی‌پدر بزرگ شد و از چهارده‌سالگی کار کرد", "hope_en": "that all four children finish school with good marks", "hope_fa": "هر چهار فرزند مدرسه را با نمره‌ی خوب تمام کنند"}, "Ali Karimi": {"talents_en": "fast on his bike, draws animals", "talents_fa": "با دوچرخه تند می‌رود، حیوان نقاشی می‌کند", "problem_en": "maths homework", "problem_fa": "تکلیف ریاضی", "past_en": "he once got lost at the beach and was found by Kian", "past_fa": "یک بار در ساحل گم شد و کیان پیدایش کرد", "hope_en": "a sheep of his own", "hope_fa": "یک گوسفند مال خودش"}, "Dariush Rahimi": {"talents_en": "calm in a crisis, good at settling quarrels", "talents_fa": "در بحران آرام است، دعواها را خوب فیصله می‌دهد", "problem_en": "too few officers for a growing town", "problem_fa": "برای شهری که بزرگ می‌شود، پلیس کم است", "past_en": "he was injured stopping a robbery when he was young", "past_fa": "در جوانی موقع جلوگیری از یک دزدی زخمی شد", "hope_en": "a town where nobody needs to lock their door", "hope_fa": "شهری که هیچ‌کس لازم نباشد درش را قفل کند"}, "Leila Rahimi": {"talents_en": "steady hands, explains things simply", "talents_fa": "دست‌های مطمئن، ساده توضیح می‌دهد", "problem_en": "the hospital needs more medicine than the budget allows", "problem_fa": "بیمارستان بیشتر از بودجه‌اش دارو لازم دارد", "past_en": "she studied by candlelight in a village without power", "past_fa": "در روستایی بی‌برق زیر نور شمع درس خواند", "hope_en": "a free clinic day every week", "hope_fa": "هر هفته یک روز درمان رایگان"}, "Sima Rahimi": {"talents_en": "chemistry, plays the setar", "talents_fa": "شیمی، سه‌تار می‌زند", "problem_en": "exam stress", "problem_fa": "استرس امتحان", "past_en": "she failed her first entrance exam and tried again", "past_fa": "بار اول در کنکور قبول نشد و دوباره تلاش کرد", "hope_en": "to become a surgeon like her mother hoped", "hope_fa": "جراح شود، همان‌طور که مادرش امید دارد"}, "Sara Ahmadi": {"talents_en": "bookkeeping, haggling with suppliers", "talents_fa": "حسابداری، چانه‌زدن با فروشنده‌ها", "problem_en": "a customer still owes her money from last month", "problem_fa": "یک مشتری هنوز پول ماه پیش را بدهکار است", "past_en": "she took over the shop when her father fell ill", "past_fa": "وقتی پدرش بیمار شد مغازه را به دست گرفت", "hope_en": "to pay off the shop loan this year", "hope_fa": "امسال وام مغازه را تسویه کند"}, "Parvin Ahmadi": {"talents_en": "storytelling, Persian poetry", "talents_fa": "قصه‌گویی، شعر فارسی", "problem_en": "lonely evenings since she retired", "problem_fa": "از وقتی بازنشسته شده، عصرها تنهاست", "past_en": "she was widowed young and raised Sara alone", "past_fa": "جوان بیوه شد و سارا را تنها بزرگ کرد", "hope_en": "to teach the town's children to read Hafez", "hope_fa": "به بچه‌های شهر حافظ‌خوانی یاد بدهد"}, "Omid Hosseini": {"talents_en": "patient with paperwork, good with numbers", "talents_fa": "حوصله‌ی کاغذبازی دارد، با عدد خوب است", "problem_en": "people blame City Hall for everything", "problem_fa": "مردم همه چیز را تقصیر شهرداری می‌دانند", "past_en": "his family's house burned down when he was a boy", "past_fa": "در بچگی خانه‌ی خانواده‌اش آتش گرفت", "hope_en": "a proper fire station and a park for the kids", "hope_fa": "یک ایستگاه آتش‌نشانی درست و یک پارک برای بچه‌ها"}, "Nasrin Hosseini": {"talents_en": "quick at the till, remembers prices", "talents_fa": "با صندوق سریع است، قیمت‌ها یادش می‌ماند", "problem_en": "long shifts leave little time for Arman", "problem_fa": "شیفت‌های طولانی وقت کمی برای آرمان می‌گذارد", "past_en": "she moved here alone from the south with one suitcase", "past_fa": "با یک چمدان تنها از جنوب به اینجا آمد", "hope_en": "a family trip to the Caspian", "hope_fa": "یک سفر خانوادگی به شمال"}, "Arman Hosseini": {"talents_en": "football, building kites", "talents_fa": "فوتبال، ساختن بادبادک", "problem_en": "the older boys tease him", "problem_fa": "پسرهای بزرگ‌تر اذیتش می‌کنند", "past_en": "he broke his arm falling from a tree last year", "past_fa": "پارسال از درخت افتاد و دستش شکست", "hope_en": "a real football pitch", "hope_fa": "یک زمین فوتبال واقعی"}, "Kian Moradi": {"talents_en": "reads the sea and the weather", "talents_fa": "دریا و هوا را می‌خواند", "problem_en": "fewer fish near the shore every year", "problem_fa": "هر سال ماهی کمتری نزدیک ساحل است", "past_en": "a storm once wrecked his father's boat", "past_fa": "یک بار طوفان قایق پدرش را شکست", "hope_en": "a bigger boat with Shirin", "hope_fa": "با شیرین یک قایق بزرگ‌تر بخرند"}, "Shirin Moradi": {"talents_en": "arranging fruit beautifully, making jam", "talents_fa": "چیدن زیبای میوه، مربا پختن", "problem_en": "the fruit spoils fast in summer", "problem_fa": "میوه در تابستان زود خراب می‌شود", "past_en": "her family's orchard dried up in a drought", "past_fa": "باغ خانواده‌اش در خشکسالی خشک شد", "hope_en": "to sell her jam at the market", "hope_fa": "مربایش را در بازار بفروشد"}, "Bahram Tehrani": {"talents_en": "joinery, carving, rebuilding roofs", "talents_fa": "نجاری، کنده‌کاری، بازسازی سقف", "problem_en": "his apprentice left for the city", "problem_fa": "شاگردش به شهر رفت", "past_en": "he rebuilt half the village after the old earthquake", "past_fa": "بعد از زلزله‌ی قدیمی نصف روستا را دوباره ساخت", "hope_en": "to train a young carpenter", "hope_fa": "یک نجار جوان تربیت کند"}, "Golnar Tehrani": {"talents_en": "teaching, calligraphy", "talents_fa": "معلمی، خوشنویسی", "problem_en": "too many children in one classroom", "problem_fa": "بچه‌های زیادی در یک کلاس", "past_en": "she and Bahram lost everything in the earthquake and started over", "past_fa": "با بهرام در زلزله همه چیز را از دست دادند و از نو شروع کردند", "hope_en": "a small library in the square", "hope_fa": "یک کتابخانه‌ی کوچک در میدان"}, "Hassan Jafari": {"talents_en": "forging, sharpening anything", "talents_fa": "آهنگری، تیز کردن هر چیزی", "problem_en": "his lungs are tired from the forge smoke", "problem_fa": "ریه‌هایش از دود کوره خسته است", "past_en": "his workshop caught fire once from a stray spark", "past_fa": "یک بار جرقه‌ای کارگاهش را آتش زد", "hope_en": "to retire and grow pomegranates", "hope_fa": "بازنشسته شود و انار بکارد"}, "Maryam Jafari": {"talents_en": "embroidery, mending", "talents_fa": "گلدوزی، وصله‌کاری", "problem_en": "her eyesight is weakening", "problem_fa": "چشم‌هایش ضعیف می‌شود", "past_en": "she sewed for others to keep the family going in hard years", "past_fa": "در سال‌های سخت برای دیگران دوخت تا خانواده سر پا بماند", "hope_en": "to teach girls in town to sew", "hope_fa": "به دخترهای شهر خیاطی یاد بدهد"}, "Navid Sadeghi": {"talents_en": "wiring, fixing radios", "talents_fa": "سیم‌کشی، تعمیر رادیو", "problem_en": "storms keep knocking out the lines", "problem_fa": "طوفان‌ها مدام خط برق را قطع می‌کنند", "past_en": "he got a bad shock as an apprentice and is careful ever since", "past_fa": "در شاگردی برق شدیدی گرفت و از آن به بعد خیلی محتاط است", "hope_en": "underground cables for the whole town", "hope_fa": "کابل زیرزمینی برای کل شهر"}, "Elena Sadeghi": {"talents_en": "calm bedside manner, speaks three languages", "talents_fa": "آرامش کنار بیمار، سه زبان بلد است", "problem_en": "night shifts", "problem_fa": "شیفت شب", "past_en": "she came here as a volunteer after a disaster and stayed for Navid", "past_fa": "بعد از یک حادثه به‌عنوان داوطلب آمد و به خاطر نوید ماند", "hope_en": "to train the town in first aid", "hope_fa": "به مردم شهر کمک‌های اولیه یاد بدهد"}, "Farhad Rostami": {"talents_en": "stone walls, strong as an ox", "talents_fa": "دیوار سنگی، زورش مثل گاو است", "problem_en": "his back after lifting stones all day", "problem_fa": "کمرش بعد از یک روز سنگ بلند کردن", "past_en": "he lost his savings to a dishonest partner", "past_fa": "پس‌اندازش را به یک شریک نادرست باخت", "hope_en": "to build a stone bridge over the river", "hope_fa": "یک پل سنگی روی رودخانه بسازد"}, "Laleh Rostami": {"talents_en": "a fine eye for gems, drawing designs", "talents_fa": "چشم دقیق برای سنگ‌های قیمتی، طراحی", "problem_en": "Farhad's old partner still owes them money", "problem_fa": "شریک قدیمی فرهاد هنوز به آن‌ها بدهکار است", "past_en": "she sold her own jewellery to keep the house", "past_fa": "جواهرات خودش را فروخت تا خانه را نگه دارد", "hope_en": "her own designs in a big city shop", "hope_fa": "طرح‌هایش در یک مغازه‌ی بزرگ شهر"}, "Dara Rostami": {"talents_en": "climbing, hide-and-seek", "talents_fa": "بالا رفتن، قایم‌باشک", "problem_en": "he is scared of the dark", "problem_fa": "از تاریکی می‌ترسد", "past_en": "he was in hospital with a high fever as a baby", "past_fa": "نوزاد بود که با تب شدید در بیمارستان بستری شد", "hope_en": "a red bicycle", "hope_fa": "یک دوچرخه‌ی قرمز"}, "Babak Nouri": {"talents_en": "pipes, pumps, clean water", "talents_fa": "لوله، پمپ، آب سالم", "problem_en": "old pipes leak under Maple St", "problem_fa": "لوله‌های قدیمی زیر خیابان افرا نشت دارند", "past_en": "he worked through a drought bringing water by truck", "past_fa": "در یک خشکسالی با تانکر آب می‌رساند", "hope_en": "a water tower for the town", "hope_fa": "یک برج آب برای شهر"}, "Ziba Nouri": {"talents_en": "running the grid, quick decisions", "talents_fa": "اداره‌ی شبکه‌ی برق، تصمیم‌های سریع", "problem_en": "not enough budget for spare transformers", "problem_fa": "بودجه برای ترانس یدکی کافی نیست", "past_en": "she kept a hospital lit with a generator through a long blackout", "past_fa": "در یک خاموشی طولانی بیمارستان را با ژنراتور روشن نگه داشت", "hope_en": "solar panels on City Hall", "hope_fa": "پنل خورشیدی روی شهرداری"}, "Thomas Bell": {"talents_en": "listening, singing", "talents_fa": "گوش دادن، آواز", "problem_en": "the church roof leaks", "problem_fa": "سقف کلیسا چکه می‌کند", "past_en": "he came from far away and learned Persian slowly", "past_fa": "از راه دور آمد و فارسی را آرام آرام یاد گرفت", "hope_en": "neighbours of every faith sharing a meal", "hope_fa": "همسایه‌ها از هر دینی سر یک سفره"}, "Anna Bell": {"talents_en": "knows every tool, gardening", "talents_fa": "همه‌ی ابزارها را می‌شناسد، باغبانی", "problem_en": "sales are slow this season", "problem_fa": "فروش این فصل کساد است", "past_en": "she nursed Thomas through a long illness", "past_fa": "در یک بیماری طولانی از توماس پرستاری کرد", "hope_en": "a community garden", "hope_fa": "یک باغچه‌ی همگانی"}, "Yusuf Haddad": {"talents_en": "calm advice, beautiful recitation", "talents_fa": "نصیحت آرام، قرائت زیبا", "problem_en": "young people are busy and visit less", "problem_fa": "جوان‌ها گرفتارند و کمتر سر می‌زنند", "past_en": "he lost his brother young and found peace in faith", "past_fa": "برادرش را جوان از دست داد و در ایمان آرامش یافت", "hope_en": "that neighbours help each other", "hope_fa": "همسایه‌ها به هم کمک کنند"}, "Amina Haddad": {"talents_en": "history, debate", "talents_fa": "تاریخ، مناظره", "problem_en": "the university needs more books", "problem_fa": "دانشگاه کتاب بیشتری لازم دارد", "past_en": "she was the first woman in her family to go to university", "past_fa": "اولین زن خانواده‌اش بود که دانشگاه رفت", "hope_en": "a scholarship for the town's girls", "hope_fa": "یک بورسیه برای دخترهای شهر"}, "Sara Karimi": {"talents_en": "draws horses, kind to her little sister", "talents_fa": "اسب نقاشی می‌کند، با خوا